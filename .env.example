# Copy to api/.env for local development, or to the server's environment file
# in production. None of these are needed to run the app and its tests locally;
# GITHUB_* are needed only to sign in for real.

# Where the SQLite database lives.
DATABASE_PATH=shop.db

# The address people open. Sign-in returns here, and writes must come from it.
PUBLIC_URL=http://localhost:5173

# A GitHub OAuth App (Settings, Developer settings, OAuth Apps) whose callback
# URL is PUBLIC_URL + /api/auth/github/callback. Use one app per address.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Who may sign in: a file with one GitHub username per line, and the word
# manager after a username for a manager. The server reads it at every
# sign-in. Unset, anyone may sign in as a sales rep.
ALLOWED_USERS_FILE=

# Behind Cloudflare, the header that carries the visitor's address, so rate
# limits count visitors and not the proxy.
CLIENT_IP_HEADER=
