    "typecheck": "tsc --noEmit",
    "lint": "oxlint && prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "msw": "^3.0.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "arctic": "^3.7.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "exports": {
    "./schemas": "./src/schemas.ts",
    "./testing": "./src/testing.ts",
    "./serve": "./src/serve.ts"
  }
