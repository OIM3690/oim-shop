{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "seed": "node --env-file-if-exists=.env src/cli/seed.ts",
    "sync": "node --env-file-if-exists=.env src/cli/sync.ts",
    "reset": "node --env-file-if-exists=.env src/cli/reset.ts",
