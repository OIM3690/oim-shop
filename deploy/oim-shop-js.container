# Quadlet unit for rootless podman: copy the three .container files to
# ~/.config/containers/systemd/ and the two .timer files to
# ~/.config/systemd/user/ on the server, then
# `systemctl --user daemon-reload && systemctl --user start oim-shop-js`.
#
# The published port and the memory limits are set on the server, not in this
# public file. Quadlet in podman 4.x does not read .container.d drop-ins, so:
# - add `PublishPort=127.0.0.1:<port>:8787` under [Container] in the copy on
#   the server;
# - put `[Service]` and `MemoryMax=<limit>` in a systemd drop-in,
#   ~/.config/systemd/user/oim-shop-js.service.d/local.conf (and the same for
#   oim-shop-js-sync.service and oim-shop-js-reset.service).
[Unit]
Description=oim-shop, the Northwind sales system for OIM3690
After=network-online.target

[Container]
Image=ghcr.io/oim3690/oim-shop:latest
ContainerName=oim-shop-js
Volume=oim-shop-js-data:/data
EnvironmentFile=%h/.config/oim-shop-js/oim-shop-js.env

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
